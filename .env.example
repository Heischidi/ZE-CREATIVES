# ─── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://zeuser:zepass@localhost:5432/zecreatives

# SECURITY — Change this to a secure 256-bit random key before deployment
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_256_BIT_RANDOM_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_TOKEN_EXPIRE_HOURS=72

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
# These are used by `python -m app.db.seed` to create the first super admin
ADMIN_SEED_EMAIL=admin@zecreatives.com
ADMIN_SEED_PASSWORD=CHANGE_THIS_PASSWORD_BEFORE_SEEDING

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD empty for dev mode (emails logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@zecreatives.com
EMAIL_FROM_NAME=Ze: Creatives

# ─── S3-compatible Storage ────────────────────────────────────────────────────
# For local dev, use MinIO (started by docker-compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=zeadmin
S3_SECRET_KEY=zepassword
S3_BUCKET_NAME=ze-creatives
S3_REGION=us-east-1

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development

# ─── CORS Origins ────────────────────────────────────────────────────────────
# Comma-separated if using multiple. Default handles Next.js dev server.

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
